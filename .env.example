# nano-llm-proxy bootstrap configuration.
#
# Copy to .env in the working directory and fill in your values. The file is
# optional: the real environment (systemd EnvironmentFile=, export, etc.)
# always wins over .env, and everything not set here falls back to built-in
# defaults. Runtime settings (rotation, retries, adapter knobs, aliases,
# model catalog) do NOT live here — they live in the database and are managed
# in the admin GUI under Settings.

# --- required on first boot only ------------------------------------------
# First-boot superadmin credentials (bootstrap fails fast without them);
# create-if-absent on later starts. Also used by -reset-admin-password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- optional bootstrap ----------------------------------------------------
#NANO_PORT=8787
#NANO_BIND=127.0.0.1
#NANO_DB_PATH=gateway.db
# Set false only for plain-HTTP local GUI use; keep true behind TLS.
#NANO_COOKIE_SECURE=true
# Extra Origin hosts accepted on /api mutations when the GUI is served behind
# a reverse proxy under a different host (comma-separated; same-host always
# allowed).
#NANO_TRUSTED_ORIGINS=gui.example.com
